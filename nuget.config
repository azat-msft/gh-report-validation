<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Locally-built Microsoft.Testing.Platform GitHub Actions report extension (and the platform
         packages it was compiled against). Committed to this repo so the workflow is self-contained. -->
    <add key="local-packages" value="./local-packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
